{
  "name": "Spaztick",
  "version": "0.1.0",
  "description": "Spaztick desktop client — tasks and projects with an AI assistant",
  "author": "J. P. Moore, with Cursor AI",
  "main": "main.js",
  "overrides": { "yallist": "^4.0.0", "which": "^2.0.2" },
  "scripts": {
    "start": "electron .",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "NO_UPDATE_NOTIFIER=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --dir",
    "build:full": "NO_UPDATE_NOTIFIER=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "build:debug": "NO_UPDATE_NOTIFIER=1 CSC_IDENTITY_AUTO_DISCOVERY=false DEBUG=electron-builder electron-builder",
    "build:log": "node build-with-log.js",
    "build:unsigned": "NO_UPDATE_NOTIFIER=1 CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "24.13.3"
  },
  "build": {
    "appId": "com.spaztick.client",
    "productName": "Spaztick",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css",
      "assets/**"
    ],
    "asar": false,
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "identity": null
    },
    "forceCodeSigning": false
  }
}
